{
  "name": "StudentAccessCode",
  "type": "object",
  "properties": {
    "studentEmail": {
      "type": "string",
      "description": "Student email (unique)"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "When student was created"
    },
    "createdByTeacherEmail": {
      "type": "string",
      "description": "Teacher who created this student"
    }
  },
  "required": [
    "studentEmail",
    "createdAt",
    "createdByTeacherEmail"
  ]
}